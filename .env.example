# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required.

# MongoDB connection string. Must be a replica set (MongoDB Atlas is fine),
# because saving a book uses a transaction.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/writt?retryWrites=true&w=majority"

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional sign-in providers. A button appears only when both keys are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
# Instagram's consumer login API was retired by Meta; keep this off unless you have a working app.
FEATURE_INSTAGRAM_LOGIN="false"
AUTH_INSTAGRAM_ID=""
AUTH_INSTAGRAM_SECRET=""

# Email of the one admin account (@annamanoliadmin). Only this account gets admin
# powers, and it's matched by email so nobody can claim it by taking the username.
# After changing it, run: npm run db:migrate-data
ADMIN_EMAIL=""
# The admin account's id. Pins admin to that exact account as well as the email,
# so nobody can become admin by registering ADMIN_EMAIL (sign-up doesn't verify
# email ownership). Recommended.
ADMIN_USER_ID=""

# Where uploaded images are stored: "mongodb" (default) or "local" (.uploads folder on disk).
STORAGE_PROVIDER="mongodb"
MAX_UPLOAD_MB="4"

# Homepage "Hot" label: stories with at least this many views, plus the top N by views.
HOT_VIEW_THRESHOLD="100"
HOT_TOP_N="3"

# Optional: lets a scheduler call /api/cron/scheduled-chapters with
# "Authorization: Bearer <CRON_SECRET>" to publish scheduled chapters on time.
CRON_SECRET=""

# A book is removed once it has this many reports (dismissed reports don't count),
# and its author can't create books for 14 days. Any value from 20 to 25.
REPORT_REMOVAL_THRESHOLD="20"

# ---- Email (parent consent, family sign-in links) ----
# Without RESEND_API_KEY, emails are written to the server log instead of sent.
RESEND_API_KEY=""
# The sender, e.g. "Writt <hello@yourdomain.com>" (a domain you verified in Resend).
EMAIL_FROM=""
# Text messages use a log-only stand-in for now (lib/sms.ts): plug in Twilio there.
# Links in emails and texts use APP_URL, or AUTH_URL if it's not set.
APP_URL=""
# Kids' accounts nobody approved within 7 days are deleted, and birthdays (13, 16)
# applied, by GET /api/cron/family with "Authorization: Bearer <CRON_SECRET>" (run daily).
# On Vercel, vercel.json schedules both jobs and sends CRON_SECRET automatically.

# ---- Testing (optional) ----
# Tests use a separate database so they never touch real accounts. Put these in a
# file named .env.testdb (not loaded by `npm run dev`), then start the test server
# with `npm run dev:test` and run `npm run test:security`:
#   DATABASE_URL="mongodb+srv://...mongodb.net/writt_dev"   (name must end in _dev)
#   ADMIN_USER_ID="<the admin's id in the test database>"
#   TEST_ADMIN_PASSWORD="<the admin's password in the test database>"
